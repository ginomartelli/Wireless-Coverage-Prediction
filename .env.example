# =============================================================================
# ChirpStack API Credentials
# =============================================================================
# Base URL of your ChirpStack instance (e.g., https://your-chirpstack-instance.com)
BASE_URL=https://your-chirpstack-instance.com

# Account 1 — Da Nang region (lat < 16.71)
EMAIL=your-email@example.com
PASSWORD=your-password

# Account 2 — Hai Phong region (lat >= 16.71)
EMAIL2=your-second-email@example.com
PASSWORD2=your-second-password

# =============================================================================
# Data Paths (optional — override defaults from config.yaml)
# =============================================================================
# COVERAGE_PREDICTOR_DATA=/app/coverage_predictor/data
# DEM_DIR=/app/coverage_predictor/data/terrain
# LANDUSE_DIR=/app/coverage_predictor/data/terrain
